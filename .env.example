# Nur für die alte Tracker-Variante unter legacy/. Die Arena hat ihre eigene .env.example
# im Repository MojoOne1/waterrower-arena.

# --- Alter Tracker -----------------------------------------------------------
# The broker the tracker signs in to. Leave MQTT_HOST at `mosquitto` if you
# uncommented the broker block in the compose file.
MQTT_HOST=mosquitto
MQTT_USERNAME=waterrower
MQTT_PASSWORD=
